# Optional environment variables. Copy to .env only if you need them; .env is git-ignored.
# Nothing in this project reads .env automatically: export the variables in your shell.

# Prefer `uv run hf auth login` over setting a token here. A token is only needed for
# `make publish` (write access) or to raise anonymous Hub rate limits (read access).
# HF_TOKEN=

# Move the Hugging Face cache (model ~1.75 GB, dataset ~1 MB) to another disk.
# HF_HOME=/Volumes/External/huggingface

# Use only cached files, never the network (after data/model have been downloaded once).
# HF_HUB_OFFLINE=1

# Run the CLI from outside the repository.
# DECISION_MODEL_ROOT=/path/to/this/repository
